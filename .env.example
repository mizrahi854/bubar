# ── Browser (public, safe to expose) ──────────────────────────────
# Supabase → Project Settings → API
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ── Server only (Vercel → Settings → Environment Variables) ───────
# Never prefix these with VITE_ — they must not reach the browser.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# Google Cloud → APIs & Services → Credentials → OAuth client (Web application)
GOOGLE_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxx

# The deployed address, without a trailing slash
APP_URL=https://your-app.vercel.app

# Random strings, 32+ characters each (for example: openssl rand -hex 32)
OAUTH_STATE_SECRET=change-me
CRON_SECRET=change-me
